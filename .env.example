# Particle Health POC configuration. Copy to .env and fill in locally.
# Never commit .env. Use SANDBOX credentials only; this POC stores data on local disk.

PORT=8100

# Shared key for the POC's internal routes (x-api-key header). Empty = unauthenticated, local only.
PARTICLE_POC_API_KEY=

# sandbox | production  (POC refuses production unless PARTICLE_ALLOW_PRODUCTION=true)
PARTICLE_ENV=sandbox
PARTICLE_BASE_URL=https://sandbox.particlehealth.com
PARTICLE_ALLOW_PRODUCTION=false

# Project-level service-account credentials (Query Flow API)
PARTICLE_CLIENT_ID=
PARTICLE_CLIENT_SECRET=
# Format: projects/<project-id>
PARTICLE_SCOPE=

# Signing key issued by Particle when the callback URL is registered.
# Empty = webhook signature verification is SKIPPED (local testing only; logged as a warning).
PARTICLE_WEBHOOK_SIGNING_KEY=
# Max age of a signed webhook before it is rejected as a replay.
PARTICLE_WEBHOOK_TOLERANCE_SECONDS=300

# Purpose of use sent on every query. Treatment requires a documented treatment relationship.
PARTICLE_PURPOSE_OF_USE=TREATMENT
# Particle asks integrators not to re-query a patient more than once per 48h.
PARTICLE_REQUERY_MIN_HOURS=48

# Query loop tuning
PARTICLE_LOOP_ENABLED=true
PARTICLE_LOOP_INTERVAL_MS=15000
PARTICLE_POLL_CEILING_MINUTES=30
PARTICLE_MAX_POLL_ERRORS=5

# Local storage root (gitignored). Contains PHI when pointed at real data.
PARTICLE_DATA_DIR=./data
